[Unit]
Description=cgv-matcher (스냅샷을 target 조건과 비교해서 Discord 알림)
After=network-online.target cgv-fetcher.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/project
ExecStart=/home/ec2-user/project/.venv/bin/python -m monitoring.match
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
