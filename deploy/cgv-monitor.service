[Unit]
Description=cgv-open-push monitor (Discord 알림 폴링)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/project
ExecStart=/home/ec2-user/project/.venv/bin/python -m monitoring.run
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
